# --- Supabase (required for live data; app renders truthful empty states when absent) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- BTCPay Server (required for checkout; checkout is disabled, never faked, when absent) ---
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# --- Email (Resend adapter; no-op logging when absent — no mail is ever sent without these) ---
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAILS=

# --- Search (Meilisearch) ---
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=https://buyhempflowernearme.com
MARKETPLACE_ADMIN_EMAILS=
# Demo catalog on non-production environments ONLY (never enable in production):
NEXT_PUBLIC_DEMO_MODE=
